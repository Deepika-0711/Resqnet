# ==============================================================================
# RESQNET Environment Configuration (Example)
# Track 2: Bharat Infra Emergency Response & Coordination Platform
# ==============================================================================

# Backend Service Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Database Configuration
# Default embedded SQLite (zero config):
DATABASE_PATH=./database.sqlite
# Optional PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resqnet

# AI Service Configuration
AI_PORT=8000
AI_HOST=0.0.0.0
# Optional external LLM API Key (Fallback NLP engine operates automatically if unset):
# GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
